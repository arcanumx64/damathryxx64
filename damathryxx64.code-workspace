            "tal7aouy.icons"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Rebuild Configuration (Flake)",
                "type": "shell",
                "command": "sudo nixos-rebuild switch --flake /home/damathryxx64/repositories/damathryxx64#nixos",
                "problemMatcher": [],
                "group": {
                    "kind": "build",
                    "isDefault": true
                },
                "detail": "Rebuild and apply the current NixOS configuration using flakes.",
                "dependsOn": [
                    "git add flake.lock"
                ],
                "dependsOrder": "sequence"
            },
            {
                "label": "Garbage Collect",
                "type": "shell",
                "command": "sudo nix-collect-garbage -d",
                "problemMatcher": [],
                "detail": "Remove old generations and clean up unused packages."
            },
            {
                "label": "Check Configuration (Flake)",
                "type": "shell",
                "command": "nixos-rebuild build --flake /home/damathryxx64/repositories/damathryxx64#nixos",
                "problemMatcher": [],
                "detail": "Check the current NixOS flake configuration without applying changes."
            },
            {
                "label": "Rollback",
                "type": "shell",
                "command": "sudo nixos-rebuild switch --rollback",
                "problemMatcher": [],
                "detail": "Rollback to the previous working configuration."
            }
        ]
    },
    "settings": {
        // Editor Font & Display
        "editor.fontFamily": "'Cascadia Code NF', Consolas, 'Courier New', 'MesloLGS NF', monospace",
        "editor.fontLigatures": true,
        "editor.fontVariations": true,
        "editor.codeLensFontFamily": "'Cascadia Code NF', Consolas, 'Courier New', 'MesloLGS NF', monospace",
        // Editor Behavior
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.autoClosingBrackets": "languageDefined",
        "editor.cursorStyle": "underline",
        "editor.wordWrap": "wordWrapColumn",
        "editor.minimap.autohide": "mouseover",
        "editor.suggestSelection": "first",
        "editor.acceptSuggestionOnEnter": "smart",
        "editor.quickSuggestionsDelay": 0,
        "editor.snippetSuggestions": "top",
        // Editor Display
        "editor.renderWhitespace": "trailing",
        "editor.renderControlCharacters": true,
        "editor.renderFinalNewline": "on",
        "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
        "editor.guides.bracketPairs": true,
        "editor.guides.indentation": true,
        "editor.stickyScroll.enabled": true,
        // Diff Editor
        "diffEditor.codeLens": true,
        "diffEditor.wordWrap": "inherit",
        "diffEditor.ignoreTrimWhitespace": false,
        // File Management
        "files.autoSave": "onWindowChange",
        "files.autoSaveWorkspaceFilesOnly": true,
        "files.autoGuessEncoding": true,
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        // Search & Replace
        "search.showLineNumbers": true,
        "search.smartCase": true,
        "search.useGlobalIgnoreFiles": true,
        "search.useParentIgnoreFiles": true,
        // Terminal
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.cursorBlinking": true,
        "terminal.integrated.persistentSessionReviveProcess": "never",
        "terminal.integrated.enableMultiLinePasteWarning": "always",
        // Explorer
        "explorer.excludeGitIgnore": true,
        "explorer.autoReveal": true,
        "explorer.confirmDelete": false,
        "explorer.confirmDragAndDrop": false,
        // Workbench
        "workbench.startupEditor": "none",
        "workbench.editor.enablePreview": false,
        "workbench.editor.highlightModifiedTabs": true,
        "workbench.editor.limit.enabled": true,
        "workbench.editor.limit.value": 8,
        "workbench.settings.openDefaultSettings": true,
        // Git
        "git.autofetch": true,
        "git.suggestSmartCommit": false,
        "git.enableSmartCommit": true,
        "git.confirmSync": false,
        "git.openRepositoryInParentFolders": "never",
        // Nix Configuration
        "alejandra.program": "alejandra",
        "nix.enableLanguageServer": true,
        "nix.serverPath": "nixd",
        "nix.serverSettings": {
            "nixd": {
                "formatting": {
                    "command": [
                        "alejandra"
                    ]
                },
                "options": {
                    "nixos": {
                        "expr": "(builtins.getFlake \"/home/damathryxx64/damathryxx64\").nixosConfigurations.nixos.options"
                    }
                }
            }
        },
        "editor.fontSize": 15,
        "editor.matchBrackets": "never",
        "editor.minimap.enabled": false,
        "editor.scrollbar.verticalScrollbarSize": 0,
        "workbench.statusBar.visible": true,
        "window.zoomLevel": 0.5,
        "git.rebaseWhenSync": true,
        "git.defaultBranchName": "trunk",
        "git.enableCommitSigning": false,
        "git.postCommitCommand": "sync",
        "files.watcherExclude": {
            "**/target": true
        },
        "terminal.integrated.fontFamily": "'Cascadia Code NF', Consolas, 'Courier New', 'MesloLGS NF', monospace"
    }
}
